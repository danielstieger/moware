	<target name="mailsupport">
		<echo>Copying mail dependencies to ${mowareWorkDir}/WEB-INF/lib</echo>
		<mkdir dir="${mowareWorkDir}/WEB-INF/lib"/>

		<copy todir="${mowareWorkDir}/WEB-INF/lib">				
